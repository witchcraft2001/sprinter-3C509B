	IFNDEF _TCPCTX_INC
	DEFINE _TCPCTX_INC

CTX_STATE		EQU 0
CTX_REMOTE_IP		EQU 1
CTX_REMOTE_MAC		EQU 5
CTX_REMOTE_PORT	EQU 11
CTX_LOCAL_PORT		EQU 13
CTX_SND_UNA		EQU 15
CTX_SND_NXT		EQU 19
CTX_RCV_NXT		EQU 23
CTX_PEER_MSS		EQU 27
CTX_PENDING_LEN	EQU 29
CTX_PENDING_OFF	EQU 31
CTX_LAST_STATUS	EQU 33
CTX_EVENT		EQU 34
CTX_REMOTE_FIN		EQU 35
CTX_REMOTE_WINDOW	EQU 36
CTX_RETRY_LEFT		EQU 38
CTX_WINDOW_CLOSED	EQU 39

EVENT_ACK		EQU 0x01
EVENT_DATA		EQU 0x02
EVENT_FIN		EQU 0x04
EVENT_RST		EQU 0x08
EVENT_SYN_ACK		EQU 0x10
EVENT_WINDOW		EQU 0x20

	ENDIF
