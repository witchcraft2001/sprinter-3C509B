; 3Com EtherLink III Stage 3 constants.
; Derived from 3Com 09-0398-002B; EEPROM is read-only in this project.
; SPDX-License-Identifier: BSD-3-Clause

	IFNDEF	_EL3_INC
	DEFINE	_EL3_INC

EL3_IDPORT_DEFAULT	EQU 0x0110
EL3_IDPORT_MIN		EQU 0x0100
EL3_IDPORT_MAX		EQU 0x01F0
EL3_BASE_MIN		EQU 0x0200
EL3_BASE_MAX		EQU 0x03E0
EL3_BASE_COUNT		EQU 31

EL3_LFSR_SEED		EQU 0xFF
EL3_LFSR_POLY		EQU 0xCF
EL3_ID_EEPROM_READ	EQU 0x80
EL3_ID_GLOBAL_RESET	EQU 0xC0
EL3_ID_TAG_ZERO		EQU 0xD0
EL3_ID_ACTIVATE_BASE	EQU 0xE0
EL3_ID_ACTIVATE_EEPROM	EQU 0xFF

EL3_REG_MFG_ID		EQU 0x00
EL3_REG_PRODUCT_ID	EQU 0x02
EL3_REG_EEPROM_CMD	EQU 0x0A
EL3_REG_EEPROM_DATA	EQU 0x0C
EL3_REG_COMMAND		EQU 0x0E
EL3_EEPROM_BUSY		EQU 0x8000
EL3_STATUS_CIP		EQU 0x1000

; DSS owns CTC channel 0. Discovery only observes its down-counter: it never
; writes the channel or changes the serial-mouse timing. At the DSS default
; rate one wrap is about 2.47 ms.
EL3_CTC_SETTLE_WRAPS	EQU 18
EL3_CTC_TIMEOUT_WRAPS	EQU 41

EL3_MFG_3COM		EQU 0x6D50
EL3_PRODUCT_3C509B_TPO	EQU 0x9550

EL3_OK			EQU 0
EL3_ERR_USAGE		EQU 1
EL3_ERR_PARAMETER	EQU 2
EL3_ERR_NOT_FOUND	EQU 3
EL3_ERR_TIMER		EQU 4
EL3_ERR_CHECKSUM	EQU 5
EL3_ERR_BASE		EQU 6
EL3_ERR_VERIFY		EQU 7
EL3_ERR_ISA_STATE	EQU 8
EL3_CLI_HELP		EQU 0x80

EL3_STAGE_ARGS		EQU 0xE0
EL3_STAGE_RESET		EQU 0xE1
EL3_STAGE_EEPROM	EQU 0xE2
EL3_STAGE_VALIDATE	EQU 0xE3
EL3_STAGE_ACTIVATE	EQU 0xE4
EL3_STAGE_VERIFY	EQU 0xE5
EL3_STAGE_PROBE		EQU 0xE6

	ENDIF
