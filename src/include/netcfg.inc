; NET.CFG normalized value layout and key bit assignments.
; SPDX-License-Identifier: BSD-3-Clause

	IFNDEF	_NETCFG_INC
	DEFINE	_NETCFG_INC

NCV_NET		EQU NETCFG_VALUES + 0	; 8 bytes
NCV_HW		EQU NETCFG_VALUES + 8	; 12 bytes
NCV_IDPORT	EQU NETCFG_VALUES + 20	; 8 bytes
NCV_MAC		EQU NETCFG_VALUES + 28	; 20 bytes
NCV_IP_SRC	EQU NETCFG_VALUES + 48	; 8 bytes
NCV_IP		EQU NETCFG_VALUES + 56	; 16 bytes
NCV_MASK	EQU NETCFG_VALUES + 72	; 16 bytes
NCV_GW		EQU NETCFG_VALUES + 88	; 16 bytes
NCV_DNS1	EQU NETCFG_VALUES + 104	; 16 bytes
NCV_DNS2	EQU NETCFG_VALUES + 120	; 16 bytes
NCV_NTP		EQU NETCFG_VALUES + 136	; 32 bytes
NCV_TZ		EQU NETCFG_VALUES + 168	; 8 bytes
NCV_END		EQU NETCFG_VALUES + 176

NCV_NET_CAP	EQU 8
NCV_HW_CAP	EQU 12
NCV_IDPORT_CAP	EQU 8
NCV_MAC_CAP	EQU 20
NCV_IP_SRC_CAP	EQU 8
NCV_IP_CAP	EQU 16
NCV_MASK_CAP	EQU 16
NCV_GW_CAP	EQU 16
NCV_DNS_CAP	EQU 16
NCV_NTP_CAP	EQU 32
NCV_TZ_CAP	EQU 8

NC_SEEN_NET	EQU 0x0001
NC_SEEN_HW	EQU 0x0002
NC_SEEN_IDPORT	EQU 0x0004
NC_SEEN_MAC	EQU 0x0008
NC_SEEN_IP	EQU 0x0010
NC_SEEN_MASK	EQU 0x0020
NC_SEEN_GW	EQU 0x0040
NC_SEEN_DNS1	EQU 0x0080
NC_SEEN_DNS2	EQU 0x0100
NC_SEEN_NTP	EQU 0x0200
NC_SEEN_TZ	EQU 0x0400

NETCFG_ACTION_SHOW	EQU 0
NETCFG_ACTION_INIT	EQU 1
NETCFG_ACTION_CHECK	EQU 2
NETCFG_ACTION_DELETE	EQU 3
NETCFG_ACTION_VERIFY	EQU 4
NETCFG_ACTION_HELP	EQU 5
NETCFG_ACTION_WRITE	EQU 6

	ENDIF
