; Minimal DSS definitions for the Sprinter 3C509B Network Kit.
; SPDX-License-Identifier: BSD-3-Clause

	IFNDEF	_DSS_INC
	DEFINE	_DSS_INC

DSS		EQU 0x10
; Sprinter BIOS RST entry (Bios.* functions, e.g. EMM_FN0..7). UNET_DLL's cold
; overlay uses BIOS_EMM_FN4 to resolve a DSS_GETMEM block into a physical page
; number without going through DSS.
BIOS		EQU 0x08
BIOS_EMM_FN4	EQU 0xC4	; A=block_id, B=index -> A=phys page
BIOS_EMM_FN5	EQU 0xC5	; A=block_id -> HL receives its physical-page list

DSS_EXIT	EQU 0x41
DSS_PUTCHAR	EQU 0x5B
DSS_PCHARS	EQU 0x5C
DSS_CREATE_OVERWRITE EQU 0x0A
DSS_CREATE_FILE EQU 0x0B
DSS_DELETE	EQU 0x0E
DSS_WRITE	EQU 0x14
DSS_WAITKEY	EQU 0x30
DSS_ECHOKEY	EQU 0x32
DSS_K_CLEAR	EQU 0x35
DSS_CHDIR	EQU 0x1D
DSS_CURDIR	EQU 0x1E
DSS_OPEN_FILE	EQU 0x11
DSS_CLOSE_FILE	EQU 0x12
DSS_READ_FILE	EQU 0x13
DSS_SYSTIME	EQU 0x21
DSS_MOVE_FP	EQU 0x15
DSS_SETTIME	EQU 0x22
DSS_SCANKEY	EQU 0x31
DSS_SETWIN1	EQU 0x39	; A=block, B=page index
DSS_SETWIN2	EQU 0x3A	; same, for a program whose image already owns WIN1
DSS_SETWIN3	EQU 0x3B	; same, for WIN3 (UNET_DLL's cold-overlay loader only:
				; staging into WIN3 happens before ISA.OPEN ever runs)
DSS_GETMEM	EQU 0x3D
DSS_FREEMEM	EQU 0x3E
DSS_ENVIRON	EQU 0x46
DSS_APPINFO	EQU 0x47

APPINFO_PARAMS		EQU 0
APPINFO_EXE_HOMEDIR	EQU 1
APPINFO_EXE_FULLPATH	EQU 2

ENV_READ_ALL	EQU 0
ENV_GET		EQU 1
ENV_SET		EQU 2
ENV_INIT	EQU 0xFF

FM_READ		EQU 1
FM_READ_WRITE	EQU 0
FM_WRITE	EQU 2
SEEK_SET	EQU 0
SEEK_CURRENT	EQU 1
SEEK_END	EQU 2
FP_BEGIN	EQU SEEK_SET
FP_CURRENT	EQU SEEK_CURRENT
FP_END		EQU SEEK_END
FA_READONLY	EQU 0x01
FA_ARCHIVE	EQU 0x20

; File-service status used by the safe existence probe. Other OPEN failures
; must never be treated as permission to create or replace a file.
DSS_ERR_FILE_NOT_FOUND EQU 3

KB_R_CTRL	EQU 0x02
KB_L_CTRL	EQU 0x08
KB_CTRL		EQU 0x20

; Common process exit classes from specs.md section 6.2.
DSS_EXIT_OK		EQU 0
DSS_EXIT_ARGUMENT	EQU 1
DSS_EXIT_HARDWARE	EQU 2
DSS_EXIT_NETWORK	EQU 3
DSS_EXIT_CONFIG		EQU 4
DSS_EXIT_LOCAL		EQU 5
DSS_EXIT_REMOTE		EQU 6
DSS_EXIT_CANCELLED	EQU 7

	ENDIF
