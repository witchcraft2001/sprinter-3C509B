; Backend-neutral IPv4/ICMP descriptor ABI for Stage 8.
; SPDX-License-Identifier: BSD-3-Clause

	IFNDEF	_IP_ICMP_INC
	DEFINE	_IP_ICMP_INC

IPV4_HEADER_LENGTH	EQU 20
IPV4_PROTOCOL_ICMP	EQU 1
IPV4_MAX_PACKET_LENGTH	EQU 1500

; IPv4 build descriptor. All words are native little endian pointers/values.
IP4B_BUFFER		EQU 0
IP4B_CAPACITY		EQU 2
IP4B_SOURCE		EQU 4
IP4B_DESTINATION	EQU 6
IP4B_DATA_LENGTH	EQU 8
IP4B_IDENTIFIER		EQU 10
IP4B_TTL		EQU 12
IP4B_PROTOCOL		EQU 13
IP4B_LENGTH		EQU 14

; IPv4 parse descriptor. EXPECT_SOURCE may be zero; EXPECT_DESTINATION must
; name four readable bytes. Successful parsing writes the final five fields.
IP4P_BUFFER		EQU 0
IP4P_LENGTH		EQU 2
IP4P_EXPECT_SOURCE	EQU 4
IP4P_EXPECT_DESTINATION EQU 6
IP4P_EXPECT_PROTOCOL	EQU 8
IP4P_DATA		EQU 9
IP4P_DATA_LENGTH	EQU 11
IP4P_IDENTIFIER		EQU 13
IP4P_SOURCE		EQU 15
IP4P_TTL		EQU 17
IP4P_DESC_LENGTH	EQU 18

; ICMP Echo build descriptor. TYPE is 8 for request and 0 for reply.
ICMPB_BUFFER		EQU 0
ICMPB_CAPACITY		EQU 2
ICMPB_PAYLOAD_LENGTH	EQU 4
ICMPB_IDENTIFIER	EQU 6
ICMPB_SEQUENCE		EQU 8
ICMPB_TYPE		EQU 10
ICMPB_LENGTH		EQU 11

; Expected Echo Reply descriptor.
ICMPR_IDENTIFIER	EQU 0
ICMPR_SEQUENCE		EQU 2
ICMPR_PAYLOAD_LENGTH	EQU 4
ICMPR_EXPECT_SOURCE	EQU 6
ICMPR_EXPECT_DESTINATION EQU 8
ICMPR_LENGTH		EQU 10

; Copy/convert an already validated Echo Request into an Echo Reply.
ICMPC_SOURCE		EQU 0
ICMPC_LENGTH		EQU 2
ICMPC_DESTINATION	EQU 4
ICMPC_CAPACITY		EQU 6
ICMPC_DESC_LENGTH	EQU 8

	ENDIF
