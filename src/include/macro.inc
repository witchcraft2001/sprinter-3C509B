	IFNDEF	_MACRO_INC
	DEFINE	_MACRO_INC

	MACRO PRINT_HL
	LD C,DSS_PCHARS
	RST DSS
	ENDM

	MACRO PRINTLN label
	LD HL,label
	PRINT_HL
	LD HL,LINE_END
	PRINT_HL
	ENDM

	MACRO DSS_EXEC function
	LD C,function
	RST DSS
	ENDM

	MACRO DSS_RETURN status
	LD B,status
	DSS_EXEC DSS_EXIT
	ENDM

	ENDIF
