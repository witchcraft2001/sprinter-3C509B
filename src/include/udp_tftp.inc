; Backend-neutral UDP and TFTP descriptor ABI for Stage 9.
; SPDX-License-Identifier: BSD-3-Clause

	IFNDEF	_UDP_TFTP_INC
	DEFINE	_UDP_TFTP_INC

UDP_HEADER_LENGTH	EQU 8
UDP_MAX_PAYLOAD		EQU 1472
IPV4_PROTOCOL_UDP	EQU 17

; UDP build descriptor. Payload bytes already follow the eight-byte header.
UDPB_BUFFER		EQU 0
UDPB_CAPACITY		EQU 2
UDPB_SOURCE_IP		EQU 4
UDPB_DESTINATION_IP	EQU 6
UDPB_PAYLOAD_LENGTH	EQU 8
UDPB_SOURCE_PORT	EQU 10
UDPB_DESTINATION_PORT	EQU 12
UDPB_DESC_LENGTH	EQU 14

; UDP parse descriptor. A zero expected source port accepts any source port;
; all other endpoint fields are mandatory. Success fills the final fields.
UDPP_BUFFER		EQU 0
UDPP_LENGTH		EQU 2
UDPP_SOURCE_IP		EQU 4
UDPP_DESTINATION_IP	EQU 6
UDPP_EXPECT_SOURCE_PORT EQU 8
UDPP_EXPECT_DEST_PORT	EQU 10
UDPP_PAYLOAD		EQU 12
UDPP_PAYLOAD_LENGTH	EQU 14
UDPP_SOURCE_PORT	EQU 16
UDPP_DESTINATION_PORT	EQU 18
UDPP_DESC_LENGTH	EQU 20

TFTP_OPCODE_RRQ		EQU 1
TFTP_OPCODE_WRQ		EQU 2
TFTP_OPCODE_DATA	EQU 3
TFTP_OPCODE_ACK		EQU 4
TFTP_OPCODE_ERROR	EQU 5
TFTP_OPCODE_OACK	EQU 6
TFTP_ERROR_UNKNOWN_TID	EQU 5
TFTP_ERROR_OPTION	EQU 8
TFTP_DEFAULT_BLOCK	EQU 512
TFTP_REQUEST_BLOCK	EQU 1428
TFTP_MIN_BLOCK		EQU 8
TFTP_MAX_BLOCK		EQU 1428
TFTP_MAX_WIRE_NAME	EQU 79

; Request builder. NAME_LENGTH is explicit and excludes the terminator.
TFTPR_BUFFER		EQU 0
TFTPR_CAPACITY		EQU 2
TFTPR_NAME		EQU 4
TFTPR_NAME_LENGTH	EQU 6
TFTPR_OPCODE		EQU 8
TFTPR_BLOCK_SIZE	EQU 10
TFTPR_DESC_LENGTH	EQU 12

; DATA builder. Data is already stored after the four-byte header.
TFTPD_BUFFER		EQU 0
TFTPD_CAPACITY		EQU 2
TFTPD_DATA_LENGTH	EQU 4
TFTPD_BLOCK		EQU 6
TFTPD_DESC_LENGTH	EQU 8

; ACK builder.
TFTPA_BUFFER		EQU 0
TFTPA_CAPACITY		EQU 2
TFTPA_BLOCK		EQU 4
TFTPA_DESC_LENGTH	EQU 6

; ERROR builder. Message length excludes the required terminating zero.
TFTPE_BUFFER		EQU 0
TFTPE_CAPACITY		EQU 2
TFTPE_CODE		EQU 4
TFTPE_MESSAGE		EQU 6
TFTPE_MESSAGE_LENGTH	EQU 8
TFTPE_DESC_LENGTH	EQU 10

; Generic parser. DATA points after the opcode/block header for DATA and to
; the bounded message for ERROR. OACK additionally returns BLOCK_SIZE.
TFTPP_BUFFER		EQU 0
TFTPP_LENGTH		EQU 2
TFTPP_OPCODE		EQU 4
TFTPP_BLOCK		EQU 6
TFTPP_DATA		EQU 8
TFTPP_DATA_LENGTH	EQU 10
TFTPP_ERROR_CODE	EQU 12
TFTPP_BLOCK_SIZE	EQU 14
TFTPP_DESC_LENGTH	EQU 16

	ENDIF
