; Real shipped SEND machine, using the CLOSE suite's packet peer and stubs.
; Both DLL placements execute these cases; no transport/state routine is mocked.
S_MS		EQU DLL_BASE+SYM_S11_ASYNC_MS_LEFT
S_CALL		EQU DLL_BASE+SYM_S11_SEND_CALL_LEFT
S_PHASE		EQU DLL_BASE+SYM_S11_SEND_PHASE
S_MISSED	EQU DLL_BASE+SYM_S11_PROBE_MISSED
S_INTERVAL	EQU DLL_BASE+SYM_S11_PROBE_INTERVAL
S_SLICE		EQU DLL_BASE+SYM_UNET_OPT_SLICE
SEND_LOOPS	EQU 0x2840
SAVED_COUNT	EQU 0x2842

	MACRO EXPECT_WORD addr, value
	LD	HL,(addr)
	LD	DE,value
	OR	A
	SBC	HL,DE
	JP	NZ,FAIL
	ENDM
	MACRO EXPECT_DE value
	LD	HL,value
	OR	A
	SBC	HL,DE
	JP	NZ,FAIL
	ENDM

SEND_CASES
	CASE	23			; min(1000,50), exact DE, no retransmit on resume
	CALL	ASYNC_CONNECTION
	EI
	CALL	DO_SEND
	PUSH	AF
	LD	A,I
	JP	PO,FAIL
	DI
	POP	AF
	EXPECT_A NERR_AGAIN
	EXPECT_DE 0
	EXPECT_WORD S_MS,950
	EXPECT_WORD S_CALL,0
	EXPECT_BYTE S_PHASE,2
	EXPECT_BYTE CAP_COUNT,1
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_DE 0
	EXPECT_WORD S_MS,900
	EXPECT_BYTE CAP_COUNT,1

	CASE	24			; equality is 1000, not zero; boundary does not TX
	CALL	ASYNC_CONNECTION
	LD	HL,1000
	LD	(S_SLICE),HL
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_DE 0
	EXPECT_BYTE CAP_COUNT,1
	EXPECT_BYTE S_PHASE,1
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_BYTE CAP_COUNT,2

	CASE	25			; one call crosses a retry: only 500 left of 1500
	CALL	ASYNC_CONNECTION
	LD	HL,1500
	LD	(S_SLICE),HL
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_WORD S_MS,1500
	EXPECT_WORD S_CALL,0
	EXPECT_BYTE CAP_COUNT,2
	LD	A,I
	JP	PE,FAIL

	CASE	26			; blocking: four silent attempts with backoff, no pend
	CALL	FRESH_CONNECTION
	CALL	DO_SEND
	EXPECT_A NERR_SEND
	EXPECT_DE 0
	EXPECT_BYTE CAP_COUNT,4
	EXPECT_BYTE A_APEND_ACTIVE,0
	CALL	DO_CLOSE
	EXPECT_A NERR_OK

	CASE	27			; window quantum and stable one-byte probe sequence
	CALL	ASYNC_WINDOW
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_DE 0
	EXPECT_WORD S_MS,950
	EXPECT_BYTE CAP_COUNT,1
	EXPECT_BYTE CAP_BUF+54,0x72 ; SEND_PAYLOAD starts "r"
	LD	HL,1000
	LD	(SEND_LOOPS),HL
	; 19 further quanta finish the first interval; no early second probe.
	LD	B,19
.FIRST_INTERVAL
	PUSH	BC
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	POP	BC
	DJNZ	.FIRST_INTERVAL
	EXPECT_BYTE CAP_COUNT,1
	EXPECT_BYTE S_MISSED,1
	EXPECT_WORD S_INTERVAL,2000
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_BYTE CAP_COUNT,2
	EXPECT_WORD S_MS,1950
	LD	HL,LOG+1
	LD	DE,LOG+LOG_ENTRY+1
	LD	B,4
	CALL	MEMCMP
	JP	NZ,FAIL

	CASE	28			; live win=0 survives >30 seconds, duplicate ACKs too
	CALL	ASYNC_WINDOW
	LD	A,1
	LD	(ACK_DATA),A
	LD	HL,620
	LD	(SEND_LOOPS),HL
.PERSIST
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_DE 0
	EXPECT_BYTE S_MISSED,0
	CALL	NEXT_SEND_LOOP
	JR	NZ,.PERSIST
	; Opening between calls must be observed without an immediate new probe.
	CALL	QUEUE_WINDOW_OPEN
	CALL	DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN
	EXPECT_BYTE A_APEND_ACTIVE,0

	CASE	29			; silent peer: exactly four unanswered probes
	CALL	ASYNC_WINDOW
	LD	HL,230
	LD	(SEND_LOOPS),HL
.SILENT
	CALL	DO_SEND
	CP	NERR_SEND
	JR	Z,.SILENT_DONE
	EXPECT_A NERR_AGAIN
	CALL	NEXT_SEND_LOOP
	JP	Z,FAIL
	JR	.SILENT
.SILENT_DONE
	EXPECT_DE 0
	EXPECT_BYTE CAP_COUNT,4
	EXPECT_BYTE A_APEND_ACTIVE,0
	EXPECT_BYTE A_CH_STATE,1

	CASE	30			; one lost probe, a valid closed-window reply resets it
	CALL	ASYNC_WINDOW
	LD	HL,1000
	LD	(S_SLICE),HL
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_BYTE S_MISSED,1
	LD	A,1
	LD	(ACK_DATA),A
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_BYTE S_MISSED,0
	EXPECT_BYTE CAP_COUNT,2
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_BYTE CAP_COUNT,2	; reply did not trigger an immediate probe

	CASE	31			; partial public call: 163 ACKed + 81 waiting for window
	CALL	ASYNC_CONNECTION
	CALL	CTX_PTR
	LD	(IX+CTX_REMOTE_WINDOW),163
	LD	(IX+CTX_REMOTE_WINDOW+1),0
	CALL	CLOSE_PEER_WINDOW
	LD	A,1
	LD	(ACK_DATA),A
	CALL	SEND_244
	EXPECT_A NERR_AGAIN
	EXPECT_DE 163
	EXPECT_WORD S_MS,951	; first ACK consumed one unit, probe ACK another
	EXPECT_BYTE CAP_COUNT,2
	; Wrong buffer/length/channel must leave the pending contract untouched.
	LD	A,0
	LD	DE,PAYLOAD_244+1
	LD	IX,244
	ENTRY	UNET_FN_SEND
	EXPECT_A NERR_STATE
	LD	A,0
	LD	DE,PAYLOAD_244
	LD	IX,243
	ENTRY	UNET_FN_SEND
	EXPECT_A NERR_STATE
	LD	A,1
	LD	DE,PAYLOAD_244
	LD	IX,244
	ENTRY	UNET_FN_SEND
	EXPECT_A NERR_STATE
	CALL	SEND_244
	EXPECT_A NERR_AGAIN
	EXPECT_DE 163
	; Both channels have durable data. RECV must not poll the queued ACK.
	LD	A,1
	CALL	ESTABLISH
	LD	HL,0x4241
	LD	(DLL_BASE+SYM_S11_PENDING0),HL
	LD	(DLL_BASE+SYM_S11_PENDING1),HL
	LD	HL,2
	LD	(A_CTX0+CTX_PENDING_LEN),HL
	LD	(A_CTX1+CTX_PENDING_LEN),HL
	CALL	QUEUE_WINDOW_OPEN
	CALL	MARK_WIRE
	XOR	A
	CALL	RECV_TWO
	LD	A,1
	CALL	RECV_TWO
	CALL	EXPECT_WIRE_QUIET
	EXPECT_WORD RX_QLEN,54
	EXPECT_WORD RECV_BUF,0x4241
	CALL	SEND_244
	EXPECT_A NERR_OK
	EXPECT_DE 244
	EXPECT_WORD PLEN,81
	LD	HL,CAP_BUF+54
	LD	DE,PAYLOAD_244+163
	LD	B,81
	CALL	MEMCMP
	JP	NZ,FAIL

	CASE	32			; FIN reopens window: finish sending to a half-closed peer
	CALL	ASYNC_WINDOW
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	LD A,0xFF
	LD (FRAME_TEMPLATE+48),A
	LD (FRAME_TEMPLATE+49),A
	CALL	QUEUE_CURRENT_ACK
	LD	B,TCP_FLAG_FIN|TCP_FLAG_ACK
	LD	C,REPLY_226_LEN
	LD	DE,REPLY_226
	XOR	A
	CALL	QUEUE_REPLY
	LD	A,1
	LD	(ACK_DATA),A
	CALL	DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN
	EXPECT_BYTE A_CH_STATE,1
	LD	A,0
	LD	DE,RECV_BUF
	LD	IX,256
	LD	IY,1
	ENTRY	UNET_FN_RECV
	EXPECT_A NERR_OK
	EXPECT_DE REPLY_226_LEN

	CASE	33			; RST has its own status, no timeout retry
	CALL	ASYNC_WINDOW
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	CALL	QUEUE_CURRENT_ACK
	LD	B,TCP_FLAG_RST|TCP_FLAG_ACK
	LD	C,0
	XOR	A
	CALL	QUEUE_REPLY
	CALL	DO_SEND
	EXPECT_A NERR_CLOSED
	EXPECT_BYTE A_CH_STATE,0

	CASE	34			; hardware error while polling a suspended window
	CALL	ASYNC_WINDOW
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	LD	A,RX_ISA_CODE
	LD	(RX_FAIL),A
	CALL	DO_SEND
	EXPECT_A NERR_HW
	EXPECT_DE 0
	EXPECT_BYTE CAP_COUNT,1
	EXPECT_BYTE A_APEND_ACTIVE,0

	CASE	35			; hardware error transmitting the very first probe
	CALL	ASYNC_WINDOW
	CALL	FAIL_NEXT_TRANSMIT
	CALL	DO_SEND
	EXPECT_A NERR_HW
	EXPECT_BYTE TX_ATTEMPTS,1
	EXPECT_BYTE A_APEND_ACTIVE,0

	CASE	36			; NETDONE is busy until cancellation finishes the SEND
	CALL	ASYNC_CONNECTION
	CALL	ENABLE_SEND_CANCEL
	LD	A,1
	CALL	ESTABLISH
	LD	A,1
	LD	(FIN_ACK_FROM+1),A
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	CALL MARK_WIRE
	ENTRY UNET_FN_NETDONE
	EXPECT_A NERR_BUSY
	CALL EXPECT_WIRE_QUIET
	CALL CANCEL_PENDING_SEND
	ENTRY	UNET_FN_NETDONE
	EXPECT_A NERR_OK
	EXPECT_BYTE A_CH_STATE,0
	EXPECT_BYTE A_CH_STATE+1,0
	EXPECT_BYTE A_APEND_ACTIVE,0

	CASE	37			; unrelated/invalid ACKs must not renew persist
	CALL	ASYNC_WINDOW
	LD	HL,1000
	LD	(S_SLICE),HL
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_BYTE S_MISSED,1
	CALL	QUEUE_CURRENT_ACK
	LD	HL,REPLY_ACK+3
	INC	(HL)			; ACK beyond SND.NXT
	XOR	A
	LD	B,TCP_FLAG_ACK
	LD	C,0
	CALL	QUEUE_REPLY
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_BYTE S_MISSED,1
	; Non-matching channel: a valid ACK on channel 1 cannot answer probe 0.
	LD	A,1
	CALL	ESTABLISH
	LD	HL,A_CTX1+CTX_SND_NXT
	LD	DE,REPLY_ACK
	LD	BC,4
	LDIR
	LD	A,1
	LD	B,TCP_FLAG_ACK
	LD	C,0
	CALL	QUEUE_REPLY
	CALL	DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_BYTE S_MISSED,2

	CASE 38 ; correct ACK number, invalid receive sequence cannot answer a probe
	CALL ASYNC_WINDOW
	LD HL,1000
	LD (S_SLICE),HL
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL QUEUE_CURRENT_ACK
	XOR A
	LD B,TCP_FLAG_ACK
	LD C,0
	CALL QUEUE_REPLY
	LD A,(IY+41)
	ADD A,LOW TCP_MSS
	LD (IY+41),A
	LD A,(IY+40)
	ADC A,HIGH TCP_MSS
	LD (IY+40),A
	CALL FIX_TCP_CKSUM
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_BYTE S_MISSED,1

	CASE 39 ; idle RECV on both channels neither polls nor consumes queued ACK
	CALL ASYNC_CONNECTION
	LD A,1
	CALL ESTABLISH
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL QUEUE_WINDOW_OPEN
	XOR A
	CALL RECV_IDLE
	LD A,1
	CALL RECV_IDLE
	EXPECT_WORD RX_QLEN,54
	EXPECT_WORD S_MS,950
	XOR A
	LD DE,RECV_BUF
	LD IX,0
	ENTRY UNET_FN_RECV
	EXPECT_A NERR_PARAM
	EXPECT_BYTE A_APEND_ACTIVE,1
	CALL DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN

	CASE 40 ; explicit keyboard cancellation during window wait
	CALL ASYNC_WINDOW
	LD A,UNET_OPT_CANCELKEYS
	LD DE,1
	ENTRY UNET_FN_SETOPT
	EXPECT_A NERR_OK
	LD A,1
	LD (KEY_PENDING),A
	CALL DO_SEND
	EXPECT_A NERR_CANCEL
	EXPECT_DE 0
	EXPECT_BYTE CAP_COUNT,1
	EXPECT_BYTE A_APEND_ACTIVE,0

	CASE 41 ; cancelled window phase closes with FIN after NETDONE was busy
	CALL ASYNC_WINDOW
	CALL ENABLE_SEND_CANCEL
	LD A,1
	CALL SET_FIN_ACK_FROM
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	ENTRY UNET_FN_NETDONE
	EXPECT_A NERR_BUSY
	CALL CANCEL_PENDING_SEND
	ENTRY UNET_FN_NETDONE
	EXPECT_A NERR_OK
	EXPECT_SEGMENTS TCP_FLAG_FIN,1
	EXPECT_SEGMENTS TCP_FLAG_RST,0
	EXPECT_BYTE A_APEND_ACTIVE,0

	CASE 42 ; configuration changes stay busy, read-only capability query works
	CALL ASYNC_CONNECTION
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	LD A,UNET_OPT_SENDSLICE
	LD DE,0
	ENTRY UNET_FN_SETOPT
	EXPECT_A NERR_BUSY
	ENTRY UNET_FN_NETINIT
	EXPECT_A NERR_BUSY
	ENTRY UNET_FN_GETCAPS
	EXPECT_A NERR_OK
	EXPECT_WORD S_SLICE,50
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_WORD S_MS,900

	CASE 43 ; terminal timeout preserves the 163-byte confirmed prefix
	CALL ASYNC_CONNECTION
	CALL CTX_PTR
	LD (IX+CTX_REMOTE_WINDOW),163
	LD (IX+CTX_REMOTE_WINDOW+1),0
	CALL CLOSE_PEER_WINDOW
	LD A,1
	LD (ACK_DATA),A
	CALL SEND_244
	EXPECT_A NERR_AGAIN
	EXPECT_DE 163
	XOR A
	LD (ACK_DATA),A
	CALL QUEUE_WINDOW_OPEN
	LD HL,230
	LD (SEND_LOOPS),HL
.PREFIX_TIMEOUT
	XOR A
	CALL RECV_IDLE
	CALL SEND_244
	CP NERR_SEND
	JR Z,.PREFIX_DONE
	EXPECT_A NERR_AGAIN
	EXPECT_DE 163
	CALL NEXT_SEND_LOOP
	JP Z,FAIL
	JR .PREFIX_TIMEOUT
.PREFIX_DONE
	EXPECT_DE 163
	EXPECT_BYTE DLL_BASE+SYM_UNET_STAGE,3
	EXPECT_BYTE A_CH_STATE,1
	EXPECT_BYTE A_APEND_ACTIVE,0

	CASE 44 ; R1: 16 KiB at 200-tick ACK latency exceeds the old 4 s call limit
	CALL ASYNC_CONNECTION
	LD HL,0
	LD (S_SLICE),HL
	LD A,1
	LD (ACK_DATA),A
	LD HL,200
	LD (ACK_DELAY),HL
	XOR A
	LD DE,VEC_BASE
	LD IX,16384
	ENTRY UNET_FN_SEND
	EXPECT_A NERR_OK
	EXPECT_DE 16384
	EXPECT_BYTE CAP_COUNT,31
	EXPECT_BYTE A_APEND_ACTIVE,0

	CASE 45 ; R1: a responsive zero-window peer may reopen after >4 s
	CALL ASYNC_WINDOW
	LD HL,0
	LD (S_SLICE),HL
	LD A,1
	LD (ACK_DATA),A
	LD A,5
	LD (OPEN_PROBE_AT),A
	CALL DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN
	EXPECT_BYTE CAP_COUNT,6

	CASE 46 ; R2: full first-chunk ACK + FIN still sends remaining 664 bytes
	CALL ASYNC_CONNECTION
	LD HL,0
	LD (S_SLICE),HL
	LD A,1
	LD (ACK_DATA),A
	LD (FIN_DATA_ONCE),A
	XOR A
	LD DE,VEC_BASE
	LD IX,1200
	ENTRY UNET_FN_SEND
	EXPECT_A NERR_OK
	EXPECT_DE 1200
	EXPECT_WORD A_CTX0+CTX_PENDING_LEN,0
	EXPECT_BYTE A_CTX0+CTX_STATE,TCP_STATE_CLOSE_WAIT
	EXPECT_BYTE A_CTX0+CTX_REMOTE_FIN,1
	EXPECT_WORD PLEN,128

	CASE 47 ; R2: a fresh SEND on an existing CLOSE_WAIT channel is legal
	CALL ASYNC_CONNECTION
	CALL CTX_PTR
	LD (IX+CTX_REMOTE_FIN),1
	LD (IX+CTX_STATE),TCP_STATE_CLOSE_WAIT
	LD A,1
	LD (ACK_DATA),A
	CALL DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN

	CASE 48 ; R2: FIN+full ACK at win=0; probe ACKs must not replay the old FIN
	CALL ASYNC_CONNECTION
	LD HL,0
	LD (S_SLICE),HL
	LD A,1
	LD (ACK_DATA),A
	LD (FIN_DATA_ONCE),A
	CALL CLOSE_PEER_WINDOW
	LD A,4
	LD (OPEN_PROBE_AT),A
	XOR A
	LD DE,VEC_BASE
	LD IX,1200
	ENTRY UNET_FN_SEND
	EXPECT_A NERR_OK
	EXPECT_DE 1200

	CASE 49 ; R3: out-of-order peer data inside our window carries a usable ACK
	CALL ASYNC_CONNECTION
	LD A,1
	LD (ACK_DATA),A
	LD (OOO_ACK_DATA),A
	CALL DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN
	EXPECT_SEGMENTS TCP_FLAG_PSH,1
	EXPECT_WORD A_CTX0+CTX_PENDING_LEN,0

	CASE 50 ; R3: an overlapping retransmission also carries an acceptable ACK
	CALL ASYNC_CONNECTION
	LD A,1
	LD (ACK_DATA),A
	LD (OOO_ACK_DATA),A
	LD HL,0xFFFF
	LD (OOO_SEQ_DELTA),HL
	CALL DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN

	CASE 51 ; ACK at RCV.NXT remains usable at zero window; full slot drops data
	CALL ASYNC_WINDOW
	LD HL,1000
	LD (S_SLICE),HL
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_BYTE S_MISSED,1
	LD HL,TCP_MSS
	LD (A_CTX0+CTX_PENDING_LEN),HL
	CALL QUEUE_CURRENT_ACK
	XOR A
	LD B,TCP_FLAG_PSH|TCP_FLAG_ACK
	LD C,2
	LD DE,REPLY_226
	CALL QUEUE_REPLY
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_BYTE S_MISSED,0
	EXPECT_WORD A_CTX0+CTX_PENDING_LEN,TCP_MSS

	CASE 52 ; buffered RECV defers EOF on owner until pending SEND finishes
	CALL ASYNC_CONNECTION
	CALL ACCEPTED_BY_LISTEN
	CALL CTX_PTR
	LD (IX+CTX_REMOTE_FIN),1
	LD (IX+CTX_STATE),TCP_STATE_CLOSE_WAIT
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	XOR A
	CALL RECV_IDLE
	EXPECT_BYTE A_CH_STATE,1
	EXPECT_BYTE A_LISTEN_ACC,1
	EXPECT_BYTE A_CTX0+CTX_STATE,TCP_STATE_CLOSE_WAIT
	CALL QUEUE_WINDOW_OPEN
	CALL DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN
	XOR A
	LD DE,RECV_BUF
	LD IX,2
	LD IY,1
	ENTRY UNET_FN_RECV
	EXPECT_A NERR_CLOSED
	EXPECT_BYTE A_CH_STATE,3
	EXPECT_BYTE A_LISTEN_ACC,0

	CASE 53 ; defer EOF on other channel too; preserve the owner's contract
	CALL ASYNC_CONNECTION
	LD A,1
	CALL ESTABLISH
	LD A,1
	CALL CTX_PTR_A
	LD (IX+CTX_REMOTE_FIN),1
	LD (IX+CTX_STATE),TCP_STATE_CLOSE_WAIT
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	LD A,1
	CALL RECV_IDLE
	EXPECT_BYTE A_CH_STATE+1,1
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	EXPECT_WORD S_MS,900

	CASE 54 ; full ACK+FIN with just one undrained byte must complete SEND
	LD HL,1
	CALL SEND_FIN_WITH_PENDING
	CASE 55 ; same boundary with 535 undrained bytes (advertised window zero)
	LD HL,TCP_MSS-1
	CALL SEND_FIN_WITH_PENDING
	CASE 56 ; even a full receive slot must not discard the FIN's ACK
	LD HL,TCP_MSS
	CALL SEND_FIN_WITH_PENDING

	CASE 57 ; new SEND after data timeout must not transmit another buffer
	CALL FRESH_CONNECTION
	CALL DO_SEND
	EXPECT_A NERR_SEND
	CALL EXPECT_SEND_REFUSED

	CASE 58 ; same guard after cancellation with unconfirmed data
	CALL ASYNC_CONNECTION
	CALL ENABLE_SEND_CANCEL
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL CANCEL_PENDING_SEND
	CALL EXPECT_SEND_REFUSED

	CASE 59 ; a window timeout has no unconfirmed bytes: fresh SEND is safe
	CALL ASYNC_WINDOW
	LD HL,0
	LD (S_SLICE),HL
	CALL DO_SEND
	EXPECT_A NERR_SEND
	CALL CTX_PTR
	LD (IX+CTX_REMOTE_WINDOW),0xFF
	LD (IX+CTX_REMOTE_WINDOW+1),0xFF
	LD A,1
	LD (ACK_DATA),A
	CALL DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN

	CASE 60 ; owner CLOSE cancels a responsive zero-window SEND immediately
	CALL ASYNC_WINDOW
	CALL ACCEPTED_BY_LISTEN
	LD A,1
	LD (ACK_DATA),A
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL MARK_WIRE
	CALL DO_CLOSE
	EXPECT_A NERR_OK
	EXPECT_BYTE A_APEND_ACTIVE,0
	EXPECT_SEGMENTS TCP_FLAG_RST,1
	EXPECT_SEGMENTS TCP_FLAG_FIN,0
	EXPECT_BYTE A_CH_STATE,3
	EXPECT_BYTE A_LISTEN_ACC,0

	CASE 61 ; FIN during SEND, then drain data/EOF between window resumes
	CALL ASYNC_CONNECTION
	LD HL,1
	LD (A_CTX0+CTX_PENDING_LEN),HL
	LD A,1
	LD (ACK_DATA),A
	LD (FIN_DATA_ONCE),A
	CALL CLOSE_PEER_WINDOW
	CALL SEND_1200
	EXPECT_A NERR_AGAIN
	EXPECT_DE TCP_MSS
	XOR A
	LD DE,RECV_BUF
	LD IX,2
	LD IY,1
	ENTRY UNET_FN_RECV
	EXPECT_A NERR_OK
	EXPECT_DE 1
	XOR A
	CALL RECV_IDLE
	EXPECT_BYTE A_CH_STATE,1
	EXPECT_BYTE A_APEND_ACTIVE,1
	CALL QUEUE_WINDOW_OPEN
.FIN_CONTINUE
	CALL SEND_1200
	CP NERR_AGAIN
	JR Z,.FIN_CONTINUE
	EXPECT_A NERR_OK
	EXPECT_DE 1200

	CASE 62 ; owner channel 1 can abort; channel 0's data/context survive
	CALL ASYNC_CONNECTION
	LD A,1
	LD (CUR_CH),A
	CALL ESTABLISH
	LD HL,2
	LD (A_CTX0+CTX_PENDING_LEN),HL
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL DO_CLOSE
	EXPECT_A NERR_OK
	EXPECT_BYTE A_CH_STATE+1,0
	EXPECT_BYTE A_CH_STATE,1
	EXPECT_WORD A_CTX0+CTX_PENDING_LEN,2
	EXPECT_BYTE A_APEND_ACTIVE,0
	EXPECT_SEGMENTS TCP_FLAG_RST,2
	LD A,1
	CALL ESTABLISH
	LD A,1
	LD (ACK_DATA),A
	CALL DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN
	XOR A
	LD (CUR_CH),A

	CASE 63 ; late ACK through ordinary RECV cannot clear a final-error latch
	CALL FRESH_CONNECTION
	CALL DO_SEND
	EXPECT_A NERR_SEND
	CALL QUEUE_WINDOW_OPEN
	XOR A
	CALL RECV_IDLE
	EXPECT_WORD RX_QLEN,0
	; The late ACK leaves no bytes in flight, so CLOSE now uses FIN.
	LD A,1
	CALL SET_FIN_ACK_FROM
	CALL EXPECT_SEND_REFUSED

	CASE 64 ; zero window with spare capacity: fast ACK+data must not append
	LD HL,1
	LD B,TCP_FLAG_PSH|TCP_FLAG_ACK
	CALL SEND_ACK_DATA_WITH_PENDING
	CASE 65 ; data followed by FIN: process its ACK, defer data and FIN
	LD HL,TCP_MSS-1
	LD B,TCP_FLAG_PSH|TCP_FLAG_ACK|TCP_FLAG_FIN
	CALL SEND_ACK_DATA_WITH_PENDING

	CASE 66 ; owner abort: lost data needs RST at UNA as well as NXT
	CALL ASYNC_CONNECTION
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL SAVE_DATA_SEQ
	CALL DO_CLOSE
	EXPECT_A NERR_OK
	EXPECT_SEGMENTS TCP_FLAG_RST,2
	LD E,0
	CALL RST_ENTRY
	LD A,SEND_LEN
	CALL EXPECT_ENTRY_DATA_SEQ_PLUS
	LD E,1
	CALL RST_ENTRY
	XOR A
	CALL EXPECT_ENTRY_DATA_SEQ_PLUS

	CASE 67 ; first abort RST fails, second must still be attempted
	CALL ASYNC_CONNECTION
	CALL DO_SEND
	LD A,2
	LD (TX_FAIL_AT),A
	CALL DO_CLOSE
	EXPECT_A NERR_HW
	EXPECT_BYTE TX_ATTEMPTS,3
	EXPECT_BYTE A_APEND_ACTIVE,0
	CALL EXPECT_RELEASED
	EXPECT_BYTE DLL_BASE+SYM_UNET_STAGE,5

	CASE 68 ; drained channel survives owner cancellation and reopens via RECV
	CALL ASYNC_CONNECTION
	LD A,1
	CALL ESTABLISH
	LD HL,1
	LD (A_CTX1+CTX_PENDING_LEN),HL
	LD A,1
	LD (A_CTX1+CTX_WINDOW_CLOSED),A
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	LD A,1
	LD DE,RECV_BUF
	LD IX,2
	LD IY,1
	ENTRY UNET_FN_RECV
	EXPECT_A NERR_OK
	EXPECT_DE 1
	CALL DO_CLOSE
	CALL MARK_WIRE
	LD A,1
	CALL RECV_IDLE
	EXPECT_BYTE A_CTX1+CTX_WINDOW_CLOSED,0
	LD HL,(CAP_BUF+48)
	LD A,H
	OR L
	JP Z,FAIL
	LD A,(TX_ATTEMPTS)
	LD HL,MARK+1
	CP (HL)
	JP Z,FAIL

	CASE 69 ; Linux persist probe: empty ACK at RCV.NXT-1 gets current ACK
	CALL FRESH_CONNECTION
	CALL QUEUE_CURRENT_ACK
	LD B,TCP_FLAG_ACK
	LD C,0
	XOR A
	CALL QUEUE_REPLY
	; CH_TABLE0's peer ISN ends in 44, so decrement has no borrow.
	DEC (IY+41)
	CALL FIX_TCP_CKSUM
	CALL MARK_WIRE
	XOR A
	CALL RECV_IDLE
	EXPECT_BYTE CAP_COUNT,1
	EXPECT_BYTE CAP_BUF+47,TCP_FLAG_ACK
	EXPECT_WORD RX_QLEN,0

	CASE 70 ; update failure on channel 0 must not skip channel 1's update
	CALL ASYNC_CONNECTION
	LD A,1
	CALL ESTABLISH
	LD A,3
	LD (A_CTX0+CTX_WINDOW_CLOSED),A
	LD (A_CTX1+CTX_WINDOW_CLOSED),A
	CALL FAIL_NEXT_TRANSMIT
	CALL DO_SEND
	EXPECT_A NERR_HW
	EXPECT_BYTE A_CTX1+CTX_WINDOW_CLOSED,0
	EXPECT_BYTE A_CTX0+CTX_WINDOW_CLOSED,2
	CALL MARK_WIRE
	XOR A
	CALL RECV_IDLE
	EXPECT_BYTE A_CTX0+CTX_WINDOW_CLOSED,0
	EXPECT_BYTE TX_ATTEMPTS,3

	CASE 71 ; failed RECV window update is retried without losing the channel
	CALL FRESH_CONNECTION
	LD A,3
	LD (A_CTX0+CTX_WINDOW_CLOSED),A
	CALL FAIL_NEXT_TRANSMIT
	XOR A
	CALL RECV_IDLE
	EXPECT_BYTE A_CTX0+CTX_WINDOW_CLOSED,2
	EXPECT_BYTE A_CH_STATE,1
	XOR A
	CALL RECV_IDLE
	EXPECT_BYTE A_CTX0+CTX_WINDOW_CLOSED,0
	EXPECT_BYTE TX_ATTEMPTS,2

	CASE 72 ; FINI aborts a suspended window phase, with no FIN/wait
	CALL ASYNC_WINDOW
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL FINI_WITHOUT_DSS_TEARDOWN
	EXPECT_BYTE A_APEND_ACTIVE,0
	EXPECT_SEGMENTS TCP_FLAG_RST,1
	EXPECT_SEGMENTS TCP_FLAG_FIN,0
	CALL EXPECT_RELEASED

	CASE 73 ; FINI also uses both sequence candidates for lost data
	CALL ASYNC_CONNECTION
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL FINI_WITHOUT_DSS_TEARDOWN
	EXPECT_SEGMENTS TCP_FLAG_RST,2
	EXPECT_SEGMENTS TCP_FLAG_FIN,0
	EXPECT_BYTE A_APEND_ACTIVE,0
	CALL EXPECT_RELEASED

	CASE 74 ; UDP SEND on the other channel preserves the TCP continuation
	CALL ASYNC_CONNECTION
	CALL ESTABLISH_UDP1
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	LD A,1
	LD DE,SEND_PAYLOAD
	LD IX,SEND_LEN
	ENTRY UNET_FN_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN
	EXPECT_BYTE A_APEND_ACTIVE,1
	CALL QUEUE_WINDOW_OPEN
	CALL DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN

	CASE 75 ; UDP buffer protection is identical with and without pending SEND
	CALL ASYNC_CONNECTION
	LD A,2
	LD (A_CH_STATE+1),A
	CALL BAD_UDP_RECV
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL BAD_UDP_RECV
	EXPECT_BYTE A_APEND_ACTIVE,1
	CALL DO_CLOSE

	CASE 76 ; refused stream has its own raw diagnostic, not peer-EOF status
	CALL FRESH_CONNECTION
	CALL DO_SEND
	EXPECT_A NERR_SEND
	CALL DO_SEND
	EXPECT_A NERR_CLOSED
	EXPECT_DE 0
	EXPECT_BYTE A_TCP_LAST,TCP_ERR_SEND_FAILED

	CASE 77 ; failed neighbor window ACK terminates a data-phase continuation
	CALL ASYNC_CONNECTION
	LD A,1
	CALL ESTABLISH
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	LD A,2
	LD (A_CTX1+CTX_WINDOW_CLOSED),A
	CALL FAIL_NEXT_TRANSMIT
	CALL DO_SEND
	EXPECT_A NERR_HW
	EXPECT_DE 0
	EXPECT_BYTE A_APEND_ACTIVE,0
	EXPECT_BYTE A_CTX0+CTX_WINDOW_CLOSED,4
	EXPECT_BYTE A_CTX1+CTX_WINDOW_CLOSED,2
	CALL EXPECT_SEND_REFUSED

	CASE 78 ; own failed window ACK has the same final-error rule
	CALL ASYNC_CONNECTION
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	LD A,2
	LD (A_CTX0+CTX_WINDOW_CLOSED),A
	CALL FAIL_NEXT_TRANSMIT
	CALL DO_SEND
	EXPECT_A NERR_HW
	EXPECT_DE 0
	EXPECT_BYTE A_CTX0+CTX_WINDOW_CLOSED,6
	CALL EXPECT_SEND_REFUSED
	RET

; Full FINI/TEARDOWN_LINK, with only physical card shutdown and the DSS
; FREEMEM instruction stubbed. NETDRV.DONE and COLD.FREE cleanup stay real.
TEARDOWN_CASES
	CALL INSTALL_TEARDOWN_STUBS
	CASE 79 ; FINI on empty contexts must never transmit, even with stale seq
	CALL RESET_MACHINE
	CALL ARM_TEARDOWN_LINK
	LD A,1
	LD (A_CTX1+CTX_SND_NXT+3),A
	CALL FULL_FINI
	EXPECT_BYTE TX_ATTEMPTS,0
	ENTRY UNET_FN_FINI
	EXPECT_A NERR_OK
	LD HL,(DLL_BASE+SYM_COLD_CTX)
	LD A,H
	OR L
	JP Z,FAIL ; idempotent FINI must not clear the cold parameter block
	EXPECT_BYTE TX_ATTEMPTS,0
	EXPECT_BYTE TEARDOWN_CARD_CALLS,1
	EXPECT_BYTE TEARDOWN_FREE_CALLS,1

	CASE 80 ; orderly CLOSE/NETDONE followed by full FINI has no extra RST
	CALL FRESH_CONNECTION
	CALL ARM_TEARDOWN_LINK
	LD A,1
	CALL SET_FIN_ACK_FROM
	CALL DO_CLOSE
	EXPECT_A NERR_OK
	ENTRY UNET_FN_NETDONE
	EXPECT_A NERR_OK
	CALL FULL_FINI
	EXPECT_SEGMENTS TCP_FLAG_FIN,1
	EXPECT_SEGMENTS TCP_FLAG_RST,0
	EXPECT_BYTE TX_ATTEMPTS,1

	CASE 81 ; full FINI: data owner sends exactly two RST, no empty tuples
	CALL ASYNC_CONNECTION
	CALL ARM_TEARDOWN_LINK
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL FULL_FINI
	EXPECT_SEGMENTS TCP_FLAG_RST,2
	EXPECT_SEGMENTS TCP_FLAG_FIN,0
	EXPECT_BYTE TX_ATTEMPTS,3
	EXPECT_BYTE A_APEND_ACTIVE,0

	CASE 82 ; full FINI: window owner sends exactly one RST
	CALL ASYNC_WINDOW
	CALL ARM_TEARDOWN_LINK
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL FULL_FINI
	EXPECT_SEGMENTS TCP_FLAG_RST,1
	EXPECT_SEGMENTS TCP_FLAG_FIN,0
	EXPECT_BYTE TX_ATTEMPTS,2

	CASE 83 ; forced teardown before NETINIT: active channel 1, empty channel 0
	CALL RESET_MACHINE
	CALL ARM_TEARDOWN_LINK
	LD A,1
	CALL ESTABLISH
	CALL DLL_BASE+SYM_TEARDOWN_LINK
	CALL EXPECT_LINK_RELEASED
	EXPECT_SEGMENTS TCP_FLAG_RST,1
	EXPECT_BYTE CAP_BUF+35,LOW LPORT1
	CALL DLL_BASE+SYM_TEARDOWN_LINK
	EXPECT_BYTE TX_ATTEMPTS,1
	EXPECT_BYTE TEARDOWN_CARD_CALLS,1
	EXPECT_BYTE TEARDOWN_FREE_CALLS,1

	CASE 84 ; a closed-but-uncleared neighbor must not send its deferred ACK
	CALL ASYNC_CONNECTION
	CALL ARM_TEARDOWN_LINK
	LD A,1
	CALL ESTABLISH
	XOR A
	LD (A_CTX1+CTX_STATE),A
	LD A,2
	LD (A_CTX1+CTX_WINDOW_CLOSED),A
	LD A,1
	LD (ACK_DATA),A
	CALL DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN
	EXPECT_BYTE TX_ATTEMPTS,1

	CASE 85 ; half-open RST must preserve channel 0's listening port
	XOR A
	CALL LISTEN_RST_RECONNECT
	CASE 86 ; identical handshake recovery on channel 1
	LD A,1
	CALL LISTEN_RST_RECONNECT

	CASE 87 ; aborting LISTEN does not need a live cold overlay
	CALL RESET_MACHINE
	CALL ARM_TEARDOWN_LINK
	XOR A
	LD DE,LISTEN_PORT
	ENTRY UNET_FN_LISTEN
	EXPECT_A NERR_OK
	XOR A
	LD (A_COLD_READY),A
	CALL DLL_BASE+SYM_TEARDOWN_LINK
	CALL EXPECT_LINK_RELEASED
	EXPECT_BYTE TX_ATTEMPTS,0
	LD HL,(DLL_BASE+SYM_COLD_CTX)
	LD A,H
	OR L
	JP Z,FAIL
	RET

; A=channel. Drive the actual public RECV/accept loop with queued packets:
; SYN -> SYN|ACK -> RST -> SYN -> SYN|ACK -> ACK, then UNLISTEN.
LISTEN_RST_RECONNECT
	LD (CUR_CH),A
	LD (TEST_CH),A
	CALL RESET_MACHINE
	LD A,1
	LD (A_COLD_READY),A
	LD (A_INITED),A
	LD A,(CUR_CH)
	LD DE,LPORT0
	OR A
	JR Z,.PORT_READY
	INC DE
.PORT_READY
	ENTRY UNET_FN_LISTEN
	EXPECT_A NERR_OK
	LD B,TCP_FLAG_SYN
	CALL LISTEN_QUEUE_CONTROL
	CALL LISTEN_POLL_IDLE
	CALL CTX_PTR
	LD A,(IX+CTX_STATE)
	EXPECT_A TCP_STATE_SYN_RECEIVED
	EXPECT_BYTE CAP_BUF+47,TCP_FLAG_SYN|TCP_FLAG_ACK
	LD B,TCP_FLAG_RST|TCP_FLAG_ACK
	CALL LISTEN_QUEUE_CONTROL
	CALL LISTEN_POLL_IDLE
	CALL CTX_PTR
	LD A,(IX+CTX_STATE)
	EXPECT_A TCP_STATE_LISTEN
	LD A,(CUR_CH)
	ADD A,LOW LPORT0
	CP (IX+CTX_LOCAL_PORT)
	JP NZ,FAIL
	LD A,(IX+CTX_LOCAL_PORT+1)
	EXPECT_A HIGH LPORT0
	LD B,TCP_FLAG_SYN
	CALL LISTEN_QUEUE_CONTROL
	CALL LISTEN_POLL_IDLE
	EXPECT_BYTE CAP_COUNT,2
	EXPECT_BYTE CAP_BUF+47,TCP_FLAG_SYN|TCP_FLAG_ACK
	LD B,TCP_FLAG_ACK
	CALL LISTEN_QUEUE_CONTROL
	CALL LISTEN_POLL_IDLE
	CALL CTX_PTR
	LD A,(IX+CTX_STATE)
	EXPECT_A TCP_STATE_ESTABLISHED
	CALL CH_STATE_PTR
	LD A,(HL)
	EXPECT_A 1
	EXPECT_BYTE A_LISTEN_ACC,1
	LD A,(CUR_CH)
	ENTRY UNET_FN_UNLISTEN
	EXPECT_A NERR_OK
	EXPECT_BYTE A_LISTEN_CH,0xFF
	RET

LISTEN_POLL_IDLE
	LD A,(CUR_CH)
	JP RECV_IDLE

LISTEN_QUEUE_CONTROL
	PUSH BC
	CALL CTX_PTR
	PUSH IX
	POP HL
	LD DE,CTX_SND_NXT
	ADD HL,DE
	LD DE,REPLY_ACK
	LD BC,4
	LDIR
	POP BC
	LD C,0
	LD A,(CUR_CH)
	JP QUEUE_REPLY

TEARDOWN_CARD_CALLS EQU 0x2850
TEARDOWN_FREE_CALLS EQU 0x2851

INSTALL_TEARDOWN_STUBS
	LD A,0xC3
	LD (DLL_BASE+SYM_EL3_DONE),A
	LD HL,TEARDOWN_CARD_STUB
	LD (DLL_BASE+SYM_EL3_DONE+1),HL
	; Replace only RST DSS / LD A,0xFF with CALL FREE_PAGE_STUB.
	LD HL,DLL_BASE+SYM_COLD_FREE+8
	LD A,(HL)
	EXPECT_A 0xD7
	INC HL
	LD A,(HL)
	EXPECT_A 0x3E
	INC HL
	LD A,(HL)
	EXPECT_A 0xFF
	LD A,0xCD
	LD (DLL_BASE+SYM_COLD_FREE+8),A
	LD HL,TEARDOWN_FREE_STUB
	LD (DLL_BASE+SYM_COLD_FREE+9),HL
	RET

ARM_TEARDOWN_LINK
	XOR A
	LD (TEARDOWN_CARD_CALLS),A
	LD (TEARDOWN_FREE_CALLS),A
	LD A,1
	LD (DLL_BASE+SYM_NETDRV_ACTIVE),A
	LD (A_COLD_READY),A
	LD (A_INITED),A
	LD A,7
	LD (DLL_BASE+SYM_COLD_BLOCK),A
	RET

FULL_FINI
	ENTRY UNET_FN_FINI
	EXPECT_A NERR_OK
EXPECT_LINK_RELEASED
	EXPECT_BYTE DLL_BASE+SYM_NETDRV_ACTIVE,0
	EXPECT_BYTE A_COLD_READY,0
	EXPECT_BYTE DLL_BASE+SYM_COLD_BLOCK,0xFF
	EXPECT_BYTE A_INITED,0
	EXPECT_BYTE A_CH_STATE,0
	EXPECT_BYTE A_CH_STATE+1,0
	EXPECT_BYTE A_CTX0+CTX_STATE,0
	EXPECT_BYTE A_CTX1+CTX_STATE,0
	EXPECT_BYTE A_LISTEN_CH,0xFF
	EXPECT_BYTE TEARDOWN_CARD_CALLS,1
	EXPECT_BYTE TEARDOWN_FREE_CALLS,1
	RET

TEARDOWN_CARD_STUB
	LD HL,TEARDOWN_CARD_CALLS
	INC (HL)
	XOR A
	RET
TEARDOWN_FREE_STUB
	EXPECT_A 7
	LD A,C
	EXPECT_A 0x3E ; DSS_FREEMEM
	LD HL,TEARDOWN_FREE_CALLS
	INC (HL)
	LD A,0xFF
	RET

BAD_UDP_RECV
	LD A,1
	LD DE,DLL_BASE+0x100
	LD IX,2
	LD IY,1
	ENTRY UNET_FN_RECV
	EXPECT_A NERR_PARAM
	RET

ESTABLISH_UDP1
	LD A,2
	LD (A_CH_STATE+1),A
	LD HL,.CONTEXT
	LD DE,DLL_BASE+SYM_UDP_CTX+14
	LD BC,14
	LDIR
	RET
.CONTEXT
	DB 192,168,1,36,0x02,0xAA,0xBB,0xCC,0xDD,0xEE
	DW PEER_PORT1,LPORT1

; FINI's close logic is real; only the subsequent DSS/card/page release is
; bypassed because this harness planted its link rather than allocating it.
FINI_WITHOUT_DSS_TEARDOWN
	LD HL,DLL_BASE+SYM_TEARDOWN_LINK
	LD A,(HL)
	PUSH AF,HL
	LD (HL),0xC9
	ENTRY UNET_FN_FINI
	POP HL,AF
	LD (HL),A
	RET

SEND_ACK_DATA_WITH_PENDING
	PUSH HL,BC
	CALL ASYNC_CONNECTION
	POP BC,HL
	LD (SAVED_COUNT),HL
	LD (A_CTX0+CTX_PENDING_LEN),HL
	PUSH BC
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL QUEUE_CURRENT_ACK
	POP BC
	LD C,2
	LD DE,REPLY_226
	XOR A
	CALL QUEUE_REPLY
	CALL DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN
	LD HL,(SAVED_COUNT)
	LD DE,(A_CTX0+CTX_PENDING_LEN)
	OR A
	SBC HL,DE
	JP NZ,FAIL
	EXPECT_BYTE A_CTX0+CTX_REMOTE_FIN,0
	RET

SEND_1200
	XOR A
	LD DE,VEC_BASE
	LD IX,1200
	ENTRY UNET_FN_SEND
	RET

SEND_FIN_WITH_PENDING
	PUSH HL
	CALL ASYNC_CONNECTION
	POP HL
	LD (SAVED_COUNT),HL
	LD (A_CTX0+CTX_PENDING_LEN),HL
	CALL DO_SEND
	EXPECT_A NERR_AGAIN
	CALL QUEUE_CURRENT_ACK
	XOR A
	LD B,TCP_FLAG_FIN|TCP_FLAG_ACK
	LD C,0
	CALL QUEUE_REPLY
	CALL DO_SEND
	EXPECT_A NERR_OK
	EXPECT_DE SEND_LEN
	LD HL,(SAVED_COUNT)
	LD DE,(A_CTX0+CTX_PENDING_LEN)
	OR A
	SBC HL,DE
	JP NZ,FAIL
	EXPECT_BYTE A_CTX0+CTX_REMOTE_FIN,1
	RET

EXPECT_SEND_REFUSED
	CALL MARK_WIRE
	XOR A
	LD DE,PAYLOAD_244
	LD IX,244
	ENTRY UNET_FN_SEND
	EXPECT_A NERR_CLOSED
	EXPECT_DE 0
	CALL EXPECT_WIRE_QUIET
	EXPECT_BYTE A_CH_STATE,1
	CALL DO_CLOSE
	EXPECT_A NERR_OK
	JP EXPECT_RELEASED

ENABLE_SEND_CANCEL
	LD A,UNET_OPT_CANCELKEYS
	LD DE,1
	ENTRY UNET_FN_SETOPT
	EXPECT_A NERR_OK
	RET
CANCEL_PENDING_SEND
	LD A,1
	LD (KEY_PENDING),A
	CALL DO_SEND
	EXPECT_A NERR_CANCEL
	RET

RECV_IDLE
	LD DE,RECV_BUF
	LD IX,2
	LD IY,1000
	ENTRY UNET_FN_RECV
	EXPECT_A NERR_OK
	EXPECT_DE 0
	RET

ASYNC_CONNECTION
	XOR	A
	LD	(CUR_CH),A
	CALL	FRESH_CONNECTION
	LD	A,UNET_OPT_SENDSLICE
	LD	DE,50
	ENTRY	UNET_FN_SETOPT
	EXPECT_A NERR_OK
	RET
ASYNC_WINDOW
	CALL	ASYNC_CONNECTION
	CALL	CTX_PTR
	LD	(IX+CTX_REMOTE_WINDOW),0
	LD	(IX+CTX_REMOTE_WINDOW+1),0
CLOSE_PEER_WINDOW
	XOR	A
	LD	(FRAME_TEMPLATE+48),A
	LD	(FRAME_TEMPLATE+49),A
	RET
QUEUE_WINDOW_OPEN
	LD	A,0xFF
	LD	(FRAME_TEMPLATE+48),A
	LD	(FRAME_TEMPLATE+49),A
	CALL	QUEUE_CURRENT_ACK
	XOR	A
	LD	B,TCP_FLAG_ACK
	LD	C,0
	JP	QUEUE_REPLY
QUEUE_CURRENT_ACK
	LD	HL,A_CTX0+CTX_SND_NXT
	LD	DE,REPLY_ACK
	LD	BC,4
	LDIR
	RET
NEXT_SEND_LOOP
	LD	HL,(SEND_LOOPS)
	DEC	HL
	LD	(SEND_LOOPS),HL
	LD	A,H
	OR	L
	RET
SEND_244
	XOR	A
	LD	DE,PAYLOAD_244
	LD	IX,244
	ENTRY	UNET_FN_SEND
	RET
RECV_TWO
	LD	DE,RECV_BUF
	LD	IX,2
	LD	IY,1000
	ENTRY	UNET_FN_RECV
	EXPECT_A NERR_OK
	EXPECT_DE 2
	RET
PAYLOAD_244
	DUP 244, n
	DB	n
	EDUP
